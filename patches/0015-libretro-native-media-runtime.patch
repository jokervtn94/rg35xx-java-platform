From: RG35XX Java Platform
Task: RGJ-RC1-011R / 010I / 011AA / RGJ-RC1-011AN / RGJ-RC1-011AO / RGJ-RC1-011AU
Subject: [PATCH] libretro: materialize RG35XX native media runtime ownership

This executable diff owns process-lifetime native media runtime setup/teardown,
explicit pinned SoundFont loading, and the independent parent audio-pipe drain
worker. 0016 remains the sole audio-pipe creation/JVM-FD argv owner. 0017 remains
the sole native->Java event wire and graceful EOF/JamVM shutdown owner.

The SoundFont path is supplied by the release/runtime overlay as the compile-time
RG35XX_SOUNDFONT_PATH macro. No BIOS/system-directory probing or fallback asset
selection is permitted. Missing/invalid SF2 leaves MIDI unavailable fail-safe;
PCM registration/mixing remains available.

This revision is rebased for strict sequential application after 0016 and 0017.
RC1-011AU places final native shutdown after the complete platform-specific Java
process teardown so the Linux call remains live after preprocessing.

--- a/src/libretro/freej2me_libretro.c
+++ b/src/libretro/freej2me_libretro.c
@@ -19,0 +20,1 @@
+#include <stdio.h>
@@ -23,0 +25,1 @@
+#include <pthread.h>
@@ -30,0 +33,2 @@
+#include "rg35xx/rg35xx_media_runtime.h"
+#include "rg35xx/rg35xx_media_cache.h"
@@ -35,0 +40,4 @@
+
+#ifndef RG35XX_SOUNDFONT_PATH
+#define RG35XX_SOUNDFONT_PATH ""
+#endif
@@ -109,0 +118,9 @@
+static pthread_t rg35xx_audio_drain_thread;
+static volatile int rg35xx_audio_drain_running;
+static int rg35xx_audio_drain_started;
+static uint8_t *rg35xx_soundfont_bytes;
+static size_t rg35xx_soundfont_size;
+
+static void rg35xx_core_media_event(int event_type,
+                                    uint32_t player_id,
+                                    uint64_t media_time_us);
@@ -820,1 +837,99 @@
+#ifdef __linux__
+static void rg35xx_release_soundfont_bytes(void)
+{
+	if(rg35xx_soundfont_bytes) free(rg35xx_soundfont_bytes);
+	rg35xx_soundfont_bytes = NULL;
+	rg35xx_soundfont_size = 0;
+}
+
+static int rg35xx_load_soundfont_bytes(void)
+{
+	FILE *f;
+	long size;
+	size_t got;
+
+	rg35xx_release_soundfont_bytes();
+	if(RG35XX_SOUNDFONT_PATH[0] == '\0')
+	{
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont path is not configured; MIDI disabled.\n");
+		return 0;
+	}
+
+	f = fopen(RG35XX_SOUNDFONT_PATH, "rb");
+	if(!f)
+	{
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont unavailable at configured path; MIDI disabled.\n");
+		return 0;
+	}
+	if(fseek(f, 0, SEEK_END) != 0 || (size = ftell(f)) <= 0 ||
+	   fseek(f, 0, SEEK_SET) != 0)
+	{
+		fclose(f);
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont could not be sized; MIDI disabled.\n");
+		return 0;
+	}
+
+	rg35xx_soundfont_bytes = (uint8_t *)malloc((size_t)size);
+	if(!rg35xx_soundfont_bytes)
+	{
+		fclose(f);
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont allocation failed; MIDI disabled.\n");
+		return 0;
+	}
+	got = fread(rg35xx_soundfont_bytes, 1, (size_t)size, f);
+	fclose(f);
+	if(got != (size_t)size)
+	{
+		rg35xx_release_soundfont_bytes();
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont read was incomplete; MIDI disabled.\n");
+		return 0;
+	}
+	rg35xx_soundfont_size = got;
+	return 1;
+}
+
+static void *rg35xx_audio_drain_main(void *unused)
+{
+	(void)unused;
+	while(rg35xx_audio_drain_running)
+	{
+		int n = rg35xx_audio_pipe_drain(&rg35xx_java_audio_pipe);
+		if(n < 0) break;
+		usleep(2000);
+	}
+	rg35xx_audio_drain_running = 0;
+	return NULL;
+}
+
+static void rg35xx_audio_drain_start(void)
+{
+	if(rg35xx_audio_drain_started || rg35xx_java_audio_pipe.read_fd < 0) return;
+	rg35xx_audio_drain_running = 1;
+	if(pthread_create(&rg35xx_audio_drain_thread, NULL,
+	                  rg35xx_audio_drain_main, NULL) == 0)
+		rg35xx_audio_drain_started = 1;
+	else
+		rg35xx_audio_drain_running = 0;
+}
+
+static void rg35xx_audio_drain_stop(void)
+{
+	if(!rg35xx_audio_drain_started) return;
+	rg35xx_audio_drain_running = 0;
+	pthread_join(rg35xx_audio_drain_thread, NULL);
+	rg35xx_audio_drain_started = 0;
+}
+
+static void rg35xx_native_media_shutdown(void)
+{
+	rg35xx_audio_drain_stop();
+	rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+	rg35xx_mixer_reset();
+	rg35xx_media_event_queue_reset();
+	rg35xx_media_cache_reset();
+	rg35xx_media_runtime_shutdown();
+	rg35xx_release_soundfont_bytes();
+}
+#endif
+
 void retro_init(void)
@@ -855,0 +971,17 @@
+
+#ifdef __linux__
+	/* Process-lifetime RG35XX media foundation. The mixer/cache remain usable for
+	 * PCM even if the explicitly configured SoundFont cannot initialize MIDI. */
+	rg35xx_media_cache_reset();
+	rg35xx_media_event_queue_reset();
+	rg35xx_mixer_init(rg35xx_core_media_event);
+	if(rg35xx_load_soundfont_bytes())
+	{
+		if(!rg35xx_media_runtime_init(rg35xx_soundfont_bytes,
+		                              rg35xx_soundfont_size))
+		{
+			log_fn(RETRO_LOG_WARN, "RG35XX MIDI runtime initialization failed; PCM remains available.\n");
+			rg35xx_release_soundfont_bytes();
+		}
+	}
+#endif
@@ -1571,0 +1704,4 @@
+
+#ifdef __linux__
+	rg35xx_native_media_shutdown();
+#endif
@@ -1657,0 +1794,1 @@
+			rg35xx_audio_drain_start();
