From: RG35XX Java Platform
Task: RGJ-RC1-011R / 010J
Subject: [PATCH] libretro: exact dedicated RG35XX audio FD inheritance

This executable diff is the authoritative process/FD owner for the dedicated
Java->native audio transport. It supersedes patch 0004 for source mutation;
0015 owns worker drain and 0017 owns graceful teardown/media shutdown.

--- a/src/libretro/freej2me_libretro.c
+++ b/src/libretro/freej2me_libretro.c
@@ -20,6 +20,7 @@
 #ifdef __linux__
 #include <stdarg.h>
 #include <unistd.h>
 #include <sys/wait.h>
+#include "rg35xx_audio_pipe.h"
 #elif _WIN32
 #include <windows.h>
 #include <tlhelp32.h>
@@ -29,7 +30,7 @@
 #include <file/file_path.h>
 #include <retro_miscellaneous.h>
 
-#define NUM_ARGUMENTS 7
+#define NUM_ARGUMENTS 8
 
 const char *slash = path_default_slash();
 
@@ -91,6 +92,7 @@
 int javaProcess;
 int pRead[2];
 int pWrite[2];
+static struct rg35xx_audio_pipe rg35xx_java_audio_pipe;
 
 #elif _WIN32
 BOOL succeeded = FALSE;
@@ -846,7 +848,8 @@
 	params[3] = strdup(freej2meapp);
 	params[4] = strdup(resArg[0]);
 	params[5] = strdup(resArg[1]);
-	params[6] = NULL; // Null-terminate the array
+	params[6] = NULL; // Original argv terminator; javaOpen may shift it for RG35XX audio.
+	params[7] = NULL;
 
 	log_fn(RETRO_LOG_INFO, "Preparing to open FreeJ2ME-Plus' Java app.\n");
 
@@ -1550,6 +1553,8 @@
 	int pid = 0;
 	int fd_stdin  = 0;
 	int fd_stdout = 1;
+	int audio_pipe_ready = 0;
+	char audio_fd_property[64];
 
 	/*
 	 * parent <-- 0 --  pRead  <-- 1 --  child
@@ -1558,12 +1563,42 @@
 	pipe(pRead); /* 0: pRead, 1: pWrite */
 	pipe(pWrite);
 
+	/* Dedicated RG35XX audio must never share stdin/stdout/stderr. Build the
+	 * inherited -D property in parent-owned argv storage before fork(). */
+	rg35xx_audio_pipe_init(&rg35xx_java_audio_pipe);
+	audio_pipe_ready = rg35xx_audio_pipe_create(&rg35xx_java_audio_pipe);
+	if(audio_pipe_ready)
+	{
+		int audio_fd = rg35xx_audio_pipe_child_fd(&rg35xx_java_audio_pipe);
+		if(audio_fd < 3)
+		{
+			rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+			audio_pipe_ready = 0;
+		}
+		else
+		{
+			snprintf(audio_fd_property, sizeof(audio_fd_property),
+				"-Dfreej2me.rg35xx.audio.fd=%d", audio_fd);
+			for(int i = 6; i >= 1; --i) { params[i + 1] = params[i]; }
+			params[1] = strdup(audio_fd_property);
+			if(params[1] == NULL)
+			{
+				for(int i = 1; i <= 6; ++i) { params[i] = params[i + 1]; }
+				params[7] = NULL;
+				rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+				audio_pipe_ready = 0;
+			}
+		}
+	}
+
 	pid = fork();
 
 	if(pid==0) /* child */
 	{
+		if(audio_pipe_ready)
+		{
+			rg35xx_audio_pipe_child_after_fork(&rg35xx_java_audio_pipe);
+		}
 
 		dup2(pWrite[0], fd_stdin);  /* read from parent pWrite */
 		dup2(pRead[1], fd_stdout);  /* write to parent pRead */
@@ -1580,13 +1615,21 @@
 
 	if(pid>0) /* parent */
 	{
+		if(audio_pipe_ready)
+		{
+			rg35xx_audio_pipe_parent_after_fork(&rg35xx_java_audio_pipe);
+		}
 		close(pRead[1]);
 		close(pWrite[0]);
 	}
 
 	if(pid<0) /* error */
 	{
+		if(audio_pipe_ready)
+		{
+			rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+		}
 		Environ(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, (void*)&messages[IMPROPER_CHILDPROC_MSG]);
 	}
 
