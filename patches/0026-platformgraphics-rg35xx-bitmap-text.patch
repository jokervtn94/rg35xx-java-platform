+/* RG35XX runtime frame receiver. The parent read end is switched to
+ * O_NONBLOCK only after the Java startup handshake. Partial headers/payloads
+ * are retained across retro_run() calls so the frontend thread never waits
+ * indefinitely for Java to paint another frame. */
+enum rg35xx_frame_rx_phase
+{
+	RG35XX_FRAME_RX_SEEK = 0,
+	RG35XX_FRAME_RX_HEADER = 1,
+	RG35XX_FRAME_RX_PAYLOAD = 2
+};
+static int rg35xx_frame_rx_phase = RG35XX_FRAME_RX_SEEK;
+static unsigned int rg35xx_frame_header_used = 0;
+static unsigned int rg35xx_frame_payload_used = 0;
+static int rg35xx_frame_rotation = 0;
+
 static void rg35xx_video_submit(void)
 {
 	static uint16_t rg35xxFrame565[MAX_WIDTH * MAX_HEIGHT];
@@ -1150,6 +1167,179 @@
 		rg35xx_send_media_event(&e);
 }
 
+#ifdef __linux__
+static void rg35xx_frame_rx_reset(void)
+{
+	rg35xx_frame_rx_phase = RG35XX_FRAME_RX_SEEK;
+	rg35xx_frame_header_used = 0;
+	rg35xx_frame_payload_used = 0;
+	rg35xx_frame_rotation = 0;
+}
+
+static int rg35xx_frame_read_would_block(int status)
+{
+	return status < 0 && (errno == EAGAIN || errno == EWOULDBLOCK);
+}
+
+static int rg35xx_receive_frame_nonblocking(void)
+{
+	int status;
+	unsigned int operations = 0;
+
+	/* Bound work per retro_run even if stdout becomes noisy. A full 640x480
+	 * RGB888 frame fits within 256 PIPE_READ_BUFFER_SIZE reads in practice;
+	 * partial state is preserved when the producer has not caught up yet. */
+	while(isRunning() && operations++ < 512)
+	{
+		if(rg35xx_frame_rx_phase == RG35XX_FRAME_RX_SEEK)
+		{
+			unsigned char marker = 0;
+			status = read_from_pipe(pRead[0], &marker, 1);
+			if(status == 1)
+			{
+				if(marker == 0xFE)
+				{
+					rg35xx_frame_rx_phase = RG35XX_FRAME_RX_HEADER;
+					rg35xx_frame_header_used = 0;
+				}
+				continue;
+			}
+			if(status == 0 || rg35xx_frame_read_would_block(status)) return 0;
+			Environ(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, (void*)&messages[INVALID_STATUS_MSG]);
+			return -1;
+		}
+
+		if(rg35xx_frame_rx_phase == RG35XX_FRAME_RX_HEADER)
+		{
+			status = read_from_pipe(pRead[0], frameHeader + rg35xx_frame_header_used,
+				15 - (int)rg35xx_frame_header_used);
+			if(status > 0)
+			{
+				rg35xx_frame_header_used += (unsigned int)status;
+				if(rg35xx_frame_header_used < 15) continue;
+
+				{
+					unsigned int rawWidth = ((unsigned int)frameHeader[0] << 8) | frameHeader[1];
+					unsigned int rawHeight = ((unsigned int)frameHeader[2] << 8) | frameHeader[3];
+					unsigned long rawPixels = (unsigned long)rawWidth * (unsigned long)rawHeight;
+					int preRumbleTime;
+
+					if(rawWidth == 0 || rawHeight == 0 || rawPixels > (sizeof(frameBuffer) / 3))
+					{
+						log_fn(RETRO_LOG_ERROR, "RG35XX frame header rejected: %ux%u\n", rawWidth, rawHeight);
+						rg35xx_frame_rx_reset();
+						frameRequested = false;
+						return -1;
+					}
+
+					rg35xx_frame_rotation = frameHeader[4];
+					preRumbleTime = ((frameHeader[5] << 24) | (frameHeader[6] << 16) |
+						(frameHeader[7] << 8) | frameHeader[8]);
+					rumbleStrength = ((frameHeader[9] << 24) | (frameHeader[10] << 16) |
+						(frameHeader[11] << 8) | frameHeader[12]);
+					characterEncoding = frameHeader[14];
+					if(frameHeader[13] == 1) resetRequested = true;
+					if(preRumbleTime > 0) rumbleTime = preRumbleTime;
+
+					if(rg35xx_frame_rotation == 1 || rg35xx_frame_rotation == 3)
+					{
+						frameWidth = rawHeight;
+						frameHeight = rawWidth;
+					}
+					else
+					{
+						frameWidth = rawWidth;
+						frameHeight = rawHeight;
+					}
+
+					frameSize = rawWidth * rawHeight;
+					frameBufferSize = frameSize * 3;
+					Geometry.base_width = frameWidth;
+					Geometry.base_height = frameHeight;
+					Geometry.max_width = MAX_WIDTH;
+					Geometry.max_height = MAX_HEIGHT;
+					Geometry.aspect_ratio = ((float)frameWidth / (float)frameHeight);
+					Environ(RETRO_ENVIRONMENT_SET_GEOMETRY, &Geometry);
+				}
+
+				rg35xx_frame_payload_used = 0;
+				rg35xx_frame_rx_phase = RG35XX_FRAME_RX_PAYLOAD;
+				continue;
+			}
+			if(status == 0 || rg35xx_frame_read_would_block(status)) return 0;
+			Environ(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, (void*)&messages[INVALID_STATUS_MSG]);
+			return -1;
+		}
+
+		if(rg35xx_frame_rx_phase == RG35XX_FRAME_RX_PAYLOAD)
+		{
+			unsigned int remaining = frameBufferSize - rg35xx_frame_payload_used;
+			unsigned int chunk = remaining < PIPE_READ_BUFFER_SIZE ? remaining : PIPE_READ_BUFFER_SIZE;
+			status = read_from_pipe(pRead[0], frameBuffer + rg35xx_frame_payload_used, (int)chunk);
+			if(status > 0)
+			{
+				rg35xx_frame_payload_used += (unsigned int)status;
+				if(rg35xx_frame_payload_used < frameBufferSize) continue;
+				break;
+			}
+			if(status == 0 || rg35xx_frame_read_would_block(status)) return 0;
+			Environ(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, (void*)&messages[INVALID_STATUS_MSG]);
+			return -1;
+		}
+	}
+
+	if(rg35xx_frame_rx_phase != RG35XX_FRAME_RX_PAYLOAD ||
+		rg35xx_frame_payload_used != frameBufferSize) return 0;
+
+	{
+		unsigned int i, j, t = 0;
+		if(rg35xx_frame_rotation == 0)
+		{
+			for(i=0; i<frameSize; i++)
+			{
+				frame[i] = (frameBuffer[t]<<16) | (frameBuffer[t+1]<<8) | frameBuffer[t+2];
+				t += 3;
+			}
+		}
+		else if(rg35xx_frame_rotation == 1)
+		{
+			for(j=0; j<frameWidth; j++)
+				for(i=0; i<frameHeight; i++)
+				{
+					frame[(i * frameWidth) + (frameWidth - 1 - j)] =
+						(frameBuffer[t]<<16) | (frameBuffer[t+1]<<8) | frameBuffer[t+2];
+					t += 3;
+				}
+		}
+		else if(rg35xx_frame_rotation == 2)
+		{
+			for(i=0; i<frameHeight; i++)
+				for(j=0; j<frameWidth; j++)
+				{
+					frame[(frameHeight - 1 - i) * frameWidth + (frameWidth - 1 - j)] =
+						(frameBuffer[t]<<16) | (frameBuffer[t+1]<<8) | frameBuffer[t+2];
+					t += 3;
+				}
+		}
+		else if(rg35xx_frame_rotation == 3)
+		{
+			for(j=0; j<frameWidth; j++)
+				for(i=frameHeight; i>0; i--)
+				{
+					frame[((i-1)*frameWidth)+j] =
+						(frameBuffer[t]<<16) | (frameBuffer[t+1]<<8) | frameBuffer[t+2];
+					t += 3;
+				}
+		}
+	}
+
+	framesDropped = 0;
+	frameRequested = false;
+	rg35xx_frame_rx_reset();
+	return 1;
+}
+#endif
