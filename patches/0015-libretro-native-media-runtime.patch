 int pRead[2];
 int pWrite[2];
 static struct rg35xx_audio_pipe rg35xx_java_audio_pipe;
+static pthread_t rg35xx_audio_drain_thread;
+static volatile int rg35xx_audio_drain_running;
+static int rg35xx_audio_drain_started;
+static uint8_t *rg35xx_soundfont_bytes;
+static size_t rg35xx_soundfont_size;
+
+static void rg35xx_core_media_event(int event_type,
