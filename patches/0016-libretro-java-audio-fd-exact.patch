From: RG35XX Java Platform
Task: RGJ-RC1-011R / 010J / 010L / RGJ-RC1-011AK / RGJ-RC1-011AL / RGJ-RC1-011AZ
Subject: [PATCH] libretro: exact RG35XX JVM selector and dedicated audio FD

This executable diff is the sole native process/JVM-argv owner. It supersedes
0004 for source mutation and owns both properties that must precede -jar:
  -Dfreej2me.rg35xx=true
  -Dfreej2me.rg35xx.audio.fd=<fd> (only when the dedicated pipe exists)
0015 owns worker drain; 0017 owns graceful teardown/media shutdown. 0018 consumes
the target selector in Java but must not mutate this argv region again.
RC1-011AZ restores the explicit {-1,-1} static pipe initializer so ownership is
fail-closed even before javaOpen() initializes/creates the dedicated pipe.

--- a/src/libretro/freej2me_libretro.c
+++ b/src/libretro/freej2me_libretro.c
@@ -23,0 +24 @@
+#include "rg35xx_audio_pipe.h"
@@ -30,7 +31,7 @@
 #include <file/file_path.h>
 #include <retro_miscellaneous.h>
 
-#define NUM_ARGUMENTS 7
+#define NUM_ARGUMENTS 9
 
 const char *slash = path_default_slash();
 
@@ -107,0 +109 @@
+static struct rg35xx_audio_pipe rg35xx_java_audio_pipe = { -1, -1 };
@@ -857,0 +860,8 @@
+	params[1] = strdup("-Dfreej2me.rg35xx=true");
+	params[2] = strdup("-jar");
+	params[3] = strdup(supported_encodings[characterEncoding]);
+	params[4] = strdup(freej2meapp);
+	params[5] = strdup(resArg[0]);
+	params[6] = strdup(resArg[1]);
+	params[7] = NULL;
+	params[8] = NULL; // javaOpen may use slot 2 for the optional audio FD property.
@@ -859,0 +870,8 @@
+	params[1] = strdup("-jar");
+	params[2] = strdup(supported_encodings[characterEncoding]);
+	params[3] = strdup(freej2meapp);
+	params[4] = strdup(resArg[0]);
+	params[5] = strdup(resArg[1]);
+	params[6] = NULL;
+	params[7] = NULL;
+	params[8] = NULL;
@@ -861,6 +879,0 @@
-	params[1] = strdup("-jar");
-	params[2] = strdup(supported_encodings[characterEncoding]);
-	params[3] = strdup(freej2meapp);
-	params[4] = strdup(resArg[0]);
-	params[5] = strdup(resArg[1]);
-	params[6] = NULL; // Null-terminate the array
@@ -1535,6 +1547,8 @@
 	int pid = 0;
 	int fd_stdin  = 0;
 	int fd_stdout = 1;
+	int audio_pipe_ready = 0;
+	char audio_fd_property[64];
 
 	/*
 	 * parent <-- 0 --  pRead  <-- 1 --  child
@@ -1544,10 +1558,42 @@
 	pipe(pRead); /* 0: pRead, 1: pWrite */
 	pipe(pWrite);
 
+	/* Dedicated RG35XX audio must never share stdin/stdout/stderr. The target
+	 * selector is already params[1]; insert the optional audio property at [2]. */
+	rg35xx_audio_pipe_init(&rg35xx_java_audio_pipe);
+	audio_pipe_ready = rg35xx_audio_pipe_create(&rg35xx_java_audio_pipe);
+	if(audio_pipe_ready)
+	{
+		int audio_fd = rg35xx_audio_pipe_child_fd(&rg35xx_java_audio_pipe);
+		if(audio_fd < 3)
+		{
+			rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+			audio_pipe_ready = 0;
+		}
+		else
+		{
+			snprintf(audio_fd_property, sizeof(audio_fd_property),
+				"-Dfreej2me.rg35xx.audio.fd=%d", audio_fd);
+			for(int i = 7; i >= 2; --i) { params[i + 1] = params[i]; }
+			params[2] = strdup(audio_fd_property);
+			if(params[2] == NULL)
+			{
+				for(int i = 2; i <= 7; ++i) { params[i] = params[i + 1]; }
+				params[8] = NULL;
+				rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+				audio_pipe_ready = 0;
+			}
+		}
+	}
+
 	pid = fork();
 
 	if(pid==0) /* child */
 	{
+		if(audio_pipe_ready)
+		{
+			rg35xx_audio_pipe_child_after_fork(&rg35xx_java_audio_pipe);
+		}
 
 		dup2(pWrite[0], fd_stdin);  /* read from parent pWrite */
 		dup2(pRead[1], fd_stdout);  /* write to parent pRead */
@@ -1565,12 +1611,20 @@
 
 	if(pid>0) /* parent */
 	{
+		if(audio_pipe_ready)
+		{
+			rg35xx_audio_pipe_parent_after_fork(&rg35xx_java_audio_pipe);
+		}
 		close(pRead[1]);
 		close(pWrite[0]);
 	}
 
 	if(pid<0) /* error */
 	{
+		if(audio_pipe_ready)
+		{
+			rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+		}
 		Environ(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, (void*)&messages[IMPROPER_CHILDPROC_MSG]);
 	}
 
