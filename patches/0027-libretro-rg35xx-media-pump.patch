From: RG35XX Java Platform
Task: RGJ-RC1-011CG / RGJ-RC1-011CH / RGJ-RC1-011CI
Subject: [PATCH] RG35XX: media pump, audio default and metric-synced bitmap text

Device evidence from RC1-011CF showed PCM/WAV, MIDI and ToneControl could enter
started state, but no audio was heard and END_OF_MEDIA never arrived. The native
mixer existed but had no render owner. The old background pipe-drain thread only
dispatched commands and could not advance PCM/MIDI time or submit samples.

RC1-011CG moves media command draining and mixer advancement onto the libretro
run owner. RC1-011CH defaults sound on when a minimal RG35XX frontend does not
expose the freej2me_sound option. RC1-011CI keeps that path but synchronizes the
bitmap fallback raster with MIDP Font metrics so overlay/annotation text uses the
same width and height contract as normal layout.

--- a/src/libretro/freej2me_libretro.c
+++ b/src/libretro/freej2me_libretro.c
@@ -158,7 +158,9 @@ int rotateScreen = 0; /* Allows rotations between 0, 90, 180 and 270 degrees */
 int phoneType = 0; /* 0=Standard (Nokia/Sony/Samsung), 1=LG, 2=Motorola/SoftBank, 3=Motorola Triplets... */
 int backlightColor = 1; /* 0=Disabled, 1=Green, etc. */
 int gameFPS = 60; /* Auto(0), 60, 55, 50, 45, 40, 35, 30, 25, 20, 15, 10 */
-int soundEnabled; /* also acts as a boolean */
+/* RG35XX fallback: sound on when the frontend omits freej2me_sound.
+ * check_variables() still honors an explicit "off" value. */
+int soundEnabled = 1; /* also acts as a boolean */
 int customMidi; /* Also acts as a boolean */
 int customFont; /* Also acts as a boolean */
 int fontOffset = 0; /* -4, -3, -2, -1, 0 (Default), 1, 2, 3, 4 */
@@ -938,13 +940,10 @@
 
 static void rg35xx_audio_drain_start(void)
 {
-	if(rg35xx_audio_drain_started || rg35xx_java_audio_pipe.read_fd < 0) return;
-	rg35xx_audio_drain_running = 1;
-	if(pthread_create(&rg35xx_audio_drain_thread, NULL,
-	                  rg35xx_audio_drain_main, NULL) == 0)
-		rg35xx_audio_drain_started = 1;
-	else
-		rg35xx_audio_drain_running = 0;
+	/* Media commands and mixer rendering are pumped on the libretro run owner.
+	 * Keep the old background drain disabled to avoid concurrent mixer state. */
+	rg35xx_audio_drain_running = 0;
+	rg35xx_audio_drain_started = 0;
 }
 
 static void rg35xx_audio_drain_stop(void)
@@ -1161,13 +1162,33 @@ static void rg35xx_send_media_event(const struct rg35xx_media_event_record *e)
 	write_to_pipe(pWrite[1], p, sizeof(p));
 }
 
+static void rg35xx_pump_media_audio(void);
+
 static void rg35xx_drain_media_events_to_java(void)
 {
 	struct rg35xx_media_event_record e;
+	/* This function is called once from retro_run(). Pump before draining
+	 * completion events so media time advances and END_OF_MEDIA is visible to
+	 * Java without adding another fragile retro_run patch hunk. */
+	rg35xx_pump_media_audio();
 	while(rg35xx_media_event_queue_pop(&e))
 		rg35xx_send_media_event(&e);
 }
 
+#define RG35XX_AUDIO_FRAMES_PER_RUN 735u /* 44100 Hz / 60 Hz libretro timing */
+static int16_t rg35xx_audio_run_buffer[RG35XX_AUDIO_FRAMES_PER_RUN * 2u];
+
+static void rg35xx_pump_media_audio(void)
+{
+	int drained = rg35xx_audio_pipe_drain(&rg35xx_java_audio_pipe);
+	size_t frames;
+	if(drained < 0)
+		log_fn(RETRO_LOG_WARN, "RG35XX media pipe drain failed; keeping frontend alive.\n");
+	frames = rg35xx_mixer_render(rg35xx_audio_run_buffer, RG35XX_AUDIO_FRAMES_PER_RUN);
+	if(AudioBatch && soundEnabled && frames > 0)
+		AudioBatch(rg35xx_audio_run_buffer, frames);
+}
+
 #ifdef __linux__
 static void rg35xx_frame_rx_reset(void)
 {
