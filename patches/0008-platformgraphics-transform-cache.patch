From: RG35XX Java Platform
Task: RGJ-RC1-011R / 008
Subject: [PATCH] PlatformGraphics: materialize geometry-only transform cache

The pinned PlatformGraphics normalizes public MIDP/DirectGraphics transforms to
its internal DoJa-style FLIP_* ids before drawTransformedImage().
RG35XXTransformCache is keyed by MIDP Sprite transform semantics, so this diff
maps the internal id once per draw and uses the cached destination-to-source map
inside the pixel loop. Mutable image pixels are never cached.

--- a/src/org/recompile/mobile/PlatformGraphics.java
+++ b/src/org/recompile/mobile/PlatformGraphics.java
@@ -3085,16 +3085,27 @@
 			// Some of the following transforms require temp variables
 			final int origSwidth = swidth;
 			final int origSheight = sheight;
 
-			if (transform == FLIP_ROTATE_RIGHT ||
-				transform == FLIP_ROTATE_LEFT ||
-				transform == FLIP_ROTATE_RIGHT_VERTICAL ||
-				transform == FLIP_ROTATE_RIGHT_HORIZONTAL)
+			/* PlatformGraphics uses DoJa-style FLIP ids internally, while the
+			 * geometry cache is keyed by MIDP Sprite transform semantics. Convert
+			 * once here instead of recomputing transform arithmetic per pixel. */
+			int cacheTransform;
+			switch (transform)
 			{
-				int tmp = swidth;
-				swidth = sheight;
-				sheight = tmp;
+				case FLIP_HORIZONTAL:                cacheTransform = Sprite.TRANS_MIRROR; break;
+				case FLIP_VERTICAL:                  cacheTransform = Sprite.TRANS_MIRROR_ROT180; break;
+				case FLIP_ROTATE:                    cacheTransform = Sprite.TRANS_ROT180; break;
+				case FLIP_ROTATE_LEFT:               cacheTransform = Sprite.TRANS_ROT270; break;
+				case FLIP_ROTATE_RIGHT:              cacheTransform = Sprite.TRANS_ROT90; break;
+				case FLIP_ROTATE_RIGHT_HORIZONTAL:   cacheTransform = Sprite.TRANS_MIRROR_ROT270; break;
+				case FLIP_ROTATE_RIGHT_VERTICAL:     cacheTransform = Sprite.TRANS_MIRROR_ROT90; break;
+				default:                             cacheTransform = Sprite.TRANS_NONE; break;
 			}
+			final RG35XXTransformCache.Map transformMap =
+				RG35XXTransformCache.get(origSwidth, origSheight, cacheTransform);
+			final int[] sourceMap = transformMap.sourceIndex;
+			swidth = transformMap.width;
+			sheight = transformMap.height;
 
 			int imgWidth = image.getWidth();
 			int[] imgData = image.getDataBuffer();
@@ -3126,43 +3137,3 @@
-					switch (transform)
-					{
-						case FLIP_HORIZONTAL:
-							imgX = sx + (origSwidth - 1 - baseX);
-							imgY = sy + baseY;
-							break;
-
-						case FLIP_VERTICAL:
-							imgX = sx + baseX;
-							imgY = sy + (origSheight - 1 - baseY);
-							break;
-
-						case FLIP_ROTATE: // 180 degrees
-							imgX = sx + (origSwidth - 1 - baseX);
-							imgY = sy + (origSheight - 1 - baseY);
-							break;
-
-						case FLIP_ROTATE_RIGHT: // ROT90
-							imgX = sx + baseY;
-							imgY = sy + (origSheight - 1 - baseX);
-							break;
-
-						case FLIP_ROTATE_LEFT: // ROT270
-							imgX = sx + (origSwidth - 1 - baseY);
-							imgY = sy + baseX;
-							break;
-
-						case FLIP_ROTATE_RIGHT_VERTICAL:
-							imgX = sx + (origSwidth - 1 - baseY);
-							imgY = sy + (origSheight - 1 - baseX);
-
-							break;
-
-						case FLIP_ROTATE_RIGHT_HORIZONTAL:
-							imgX = sx + baseY;
-							imgY = sy + baseX;
-							break;
-
-						default:
-							imgX = sx + baseX;
-							imgY = sy + baseY;
-							break;
-					}
+					final int local = sourceMap[baseY * transformMap.width + baseX];
+					imgX = sx + (local % origSwidth);
+					imgY = sy + (local / origSwidth);
