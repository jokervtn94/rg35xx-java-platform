From: RG35XX Java Platform
Task: RGJ-RC1-011R / 010M / RGJ-RC1-011AP / RGJ-RC1-011AQ
Subject: [PATCH] media: materialize JavaSound-free RG35XX ToneControl and playTone

This executable diff applies after 0018. It preserves the desktop JavaSound
path, routes device://tone and ToneControl through RG35XXToneSequenceEncoder +
RG35XXNativePlayer, and keeps device://midi unadvertised/safe on RG35XX because
live short-message transport is not implemented. 0003 already owns/imports the
RG35XX target-profile selector in Manager.

The remaining ToneControl/playTone edits use exact zero-context insertion
coordinates so strict `--fuzz=0` assembly does not depend on stale surrounding
whitespace/context.

--- a/src/org/recompile/mobile/PlatformPlayer.java
+++ b/src/org/recompile/mobile/PlatformPlayer.java
@@ -342,5 +342,38 @@
 	public PlatformPlayer(String locator)
 	{
+		if(RG35XXPlatformProfile.isActive())
+		{
+			listeners = new Vector<PlayerListener>();
+			siemensListeners = new Vector<com.siemens.mp.media.PlayerListener>();
+			kddiListeners = new Vector<com.kddi.media.MediaEventListener>();
+			controls = new Control[NUM_CONTROLS];
+
+			if(locator.equals(Manager.TONE_DEVICE_LOCATOR))
+			{
+				try
+				{
+					contentType = "audio/x-tone-seq";
+					rg35xxPlayer = new RG35XXNativePlayer(new ByteArrayInputStream(new byte[0]), contentType);
+					bindRG35XXEvents();
+					player = new rg35xxAudioPlayer();
+					controls[0] = new volumeControl(player);
+					controls[3] = new toneControl(player);
+				}
+				catch(Exception e)
+				{
+					player = new audioplayer();
+					disableControls = true;
+				}
+				return;
+			}
+
+			/* Complete-blob native transport has no live device://midi messages. */
+			contentType = "audio/midi (stub)";
+			player = new audioplayer();
+			disableControls = true;
+			return;
+		}
+
 		if(locator.equals(Manager.TONE_DEVICE_LOCATOR) || locator.equals(Manager.MIDI_DEVICE_LOCATOR))
 		{
 			Mobile.log(Mobile.LOG_WARNING, PlatformPlayer.class.getPackage().getName() + "." + PlatformPlayer.class.getSimpleName() + ": " + " Creating MIDI Player for locator: "+locator);
