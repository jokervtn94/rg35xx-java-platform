+
 
 	public static synchronized Player createPlayer(InputStream stream, String type) throws IOException, MediaException
 	{
@@ -173,0 +180,45 @@
+
+		if(RG35XXPlatformProfile.isActive())
+		{
+			final int effectiveDuration = duration < 50 ? 50 : duration;
+			try
+			{
+				final RG35XXNativePlayer next = new RG35XXNativePlayer(
+					new ByteArrayInputStream(new byte[0]), "audio/x-tone-seq");
+				next.setMidi(RG35XXToneSequenceEncoder.encodeSingleTone(note, effectiveDuration, volume));
+				final int nextId = next.getPlayerId();
+				next.setEventListener(new RG35XXMediaRegistry.EventListener()
+				{
+					public void onNativeMediaEvent(int playerId, int eventType, long mediaTimeUs)
+					{
+						if(eventType != RG35XXMediaRegistry.EVENT_END_OF_MEDIA) return;
+						synchronized(Manager.class)
+						{
+							if(rg35xxTonePlayerId == playerId && rg35xxTonePlayer == next)
+							{
+								rg35xxTonePlayer.close();
+								rg35xxTonePlayer = null;
+								rg35xxTonePlayerId = 0;
+							}
+						}
+					}
+				});
+
+				if(rg35xxTonePlayer != null) rg35xxTonePlayer.close();
+				rg35xxTonePlayer = next;
+				rg35xxTonePlayerId = nextId;
+				next.realize();
+				if(!next.prefetch() || !next.start())
+				{
+					next.close();
+					rg35xxTonePlayer = null;
+					rg35xxTonePlayerId = 0;
+					throw new MediaException("RG35XX tone transport unavailable");
+				}
+				return;
+			}
+			catch(IOException e)
+			{
+				throw new MediaException("RG35XX tone setup failed: " + e.getMessage());
+			}
+		}
