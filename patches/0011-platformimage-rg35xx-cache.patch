From: RG35XX Java Platform
Task: RGJ-RC1-011R / 006
Subject: [PATCH] PlatformImage: materialize immutable byte-array decode cache

This executable diff keeps upstream PlatformImage as the decoder/facade owner.
Only immutable byte-array images are cache eligible. Cache hits reconstruct a
fresh TYPE_INT_ARGB image from defensive pixel copies; mutable DoJa images and
all other constructors remain unchanged.

--- a/src/org/recompile/mobile/PlatformImage.java
+++ b/src/org/recompile/mobile/PlatformImage.java
@@ -203,8 +203,24 @@
 	public PlatformImage(byte[] imageData, int imageOffset, int imageLength, boolean mutable) // DoJa also uses this one, creates mutable images like DirectGraphics
 	{
 		// Create Image from Byte Array Range (Data is PNG, JPG, etc.)
+		String rgCacheKey = null;
+		if(!mutable)
+		{
+			rgCacheKey = RG35XXImageCache.keyForBytes(imageData, imageOffset, imageLength);
+			RG35XXImageCache.CachedImage rgCached = RG35XXImageCache.get(rgCacheKey);
+			if(rgCached != null)
+			{
+				canvas = new BufferedImage(rgCached.width, rgCached.height, BufferedImage.TYPE_INT_ARGB);
+				dataBuffer = ((DataBufferInt) canvas.getRaster().getDataBuffer()).getData();
+				System.arraycopy(rgCached.pixels, 0, dataBuffer, 0, rgCached.pixels.length);
+				isMutable = false;
+				return;
+			}
+		}
+
 		InputStream stream = new ByteArrayInputStream(imageData, imageOffset, imageLength);
 
 		BufferedImage image;
 		
@@ -221,6 +237,10 @@
 		}
 
 		dataBuffer = ((DataBufferInt) canvas.getRaster().getDataBuffer()).getData();
+
+		/* Store only the final normalized immutable ARGB/RGB result. Any target
+		 * compatibility repair added before this point is therefore cached after repair. */
+		if(!mutable && rgCacheKey != null)
+			RG35XXImageCache.put(rgCacheKey, canvas.getWidth(), canvas.getHeight(), dataBuffer);
 		isMutable = mutable;
 	}
