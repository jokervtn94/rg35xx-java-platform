From: RG35XX Java Platform
Task: RGJ-RC1-011BV
Subject: [PATCH] libretro: force GNU Classpath HeadlessToolkit on RG35XX

Real-device stderr after 011BU showed GNU Classpath selecting GtkToolkit and
failing on missing libgtkpeer.so before any MIDlet could start. RG35XX is a
headless libretro target and must not depend on GTK.

This patch is applied after 0024. It changes only the Linux/RG35XX JVM argv:
- grows the argv allocation by one slot;
- inserts -Dawt.toolkit=gnu.java.awt.peer.headless.HeadlessToolkit;
- keeps the optional audio FD property immediately after the fixed target
  properties and before -jar;
- leaves Windows/desktop argv behavior unchanged.

--- a/src/libretro/freej2me_libretro.c
+++ b/src/libretro/freej2me_libretro.c
@@ -31,7 +31,7 @@
 #include <file/file_path.h>
 #include <retro_miscellaneous.h>
 
-#define NUM_ARGUMENTS 9
+#define NUM_ARGUMENTS 10
 
 const char *slash = path_default_slash();
 
@@ -992,24 +992,27 @@
 	params = (char**)malloc(sizeof(char*) * NUM_ARGUMENTS);
 #ifdef __linux__
 	params[0] = strdup("java");
 	params[1] = strdup("-Dfreej2me.rg35xx=true");
-	params[2] = strdup("-jar");
-	params[3] = strdup(supported_encodings[characterEncoding]);
-	params[4] = strdup(freej2meapp);
-	params[5] = strdup(resArg[0]);
-	params[6] = strdup(resArg[1]);
-	params[7] = NULL;
-	params[8] = NULL; // javaOpen may use slot 2 for the optional audio FD property.
+	params[2] = strdup("-Dawt.toolkit=gnu.java.awt.peer.headless.HeadlessToolkit");
+	params[3] = strdup("-jar");
+	params[4] = strdup(supported_encodings[characterEncoding]);
+	params[5] = strdup(freej2meapp);
+	params[6] = strdup(resArg[0]);
+	params[7] = strdup(resArg[1]);
+	params[8] = NULL;
+	params[9] = NULL; // javaOpen may use slot 3 for the optional audio FD property.
 #elif _WIN32
 	params[0] = strdup("javaw");
 	params[1] = strdup("-jar");
 	params[2] = strdup(supported_encodings[characterEncoding]);
 	params[3] = strdup(freej2meapp);
 	params[4] = strdup(resArg[0]);
 	params[5] = strdup(resArg[1]);
 	params[6] = NULL;
 	params[7] = NULL;
 	params[8] = NULL;
+	params[9] = NULL;
 #endif
@@ -1790,22 +1793,22 @@
-	/* Dedicated RG35XX audio must never share stdin/stdout/stderr. The target
-	 * selector is already params[1]; insert the optional audio property at [2]. */
+	/* Dedicated RG35XX audio must never share stdin/stdout/stderr. The target
+	 * and headless-toolkit selectors occupy [1..2]; insert audio at [3]. */
 	rg35xx_audio_pipe_init(&rg35xx_java_audio_pipe);
 	audio_pipe_ready = rg35xx_audio_pipe_create(&rg35xx_java_audio_pipe);
 	if(audio_pipe_ready)
 	{
 		int audio_fd = rg35xx_audio_pipe_child_fd(&rg35xx_java_audio_pipe);
 		if(audio_fd < 3)
 		{
 			rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
 			audio_pipe_ready = 0;
 		}
 		else
 		{
 			snprintf(audio_fd_property, sizeof(audio_fd_property),
 				"-Dfreej2me.rg35xx.audio.fd=%d", audio_fd);
-			for(int i = 7; i >= 2; --i) { params[i + 1] = params[i]; }
-			params[2] = strdup(audio_fd_property);
-			if(params[2] == NULL)
+			for(int i = 8; i >= 3; --i) { params[i + 1] = params[i]; }
+			params[3] = strdup(audio_fd_property);
+			if(params[3] == NULL)
 			{
-				for(int i = 2; i <= 7; ++i) { params[i] = params[i + 1]; }
-				params[8] = NULL;
+				for(int i = 3; i <= 8; ++i) { params[i] = params[i + 1]; }
+				params[9] = NULL;
 				rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
 				audio_pipe_ready = 0;
 			}
