 			byte[] buffer;
+			final byte[] rg35xxMediaEvent = new byte[13];
@@ -334 +336,26 @@
+							case 14: // RG35XX native LOOPED / END_OF_MEDIA event
+								if(code != 13) { throw new IOException("Invalid RG35XX media event length: " + code); }
+								bytesRead = 0;
+								while(bytesRead < rg35xxMediaEvent.length)
