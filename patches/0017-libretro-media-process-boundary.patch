From: RG35XX Java Platform
Task: RGJ-RC1-011R / 010K / RGJ-RC1-011AM
Subject: [PATCH] libretro: materialize native media event boundary and graceful EOF

This executable diff owns only the cross-process event return and graceful EOF
request. 0015 remains the owner of native media runtime/mixer startup and final
native resource teardown. 0016 remains the owner of dedicated audio FD/argv.
This revision is rebased for sequential application after 0016/0010 and imports
IOException explicitly for the fail-closed Java event parser.

--- a/src/libretro/freej2me_libretro.c
+++ b/src/libretro/freej2me_libretro.c
@@ -27,4 +27,7 @@
 #endif
 #include "freej2me_libretro.h"
+#include "rg35xx/rg35xx_media_events.h"
+#include "rg35xx/rg35xx_media_event_queue.h"
+#include "rg35xx/rg35xx_mixer.h"
 #include <file/file_path.h>
 #include <retro_miscellaneous.h>
@@ -948,3 +951,42 @@
 void retro_unload_game(void) { /* FreeJ2ME closes the game by itself */ }
+
+/* Audio/mixer callback context only enqueues. It never writes pWrite[1]. */
+static void rg35xx_core_media_event(int event_type,
+                                    uint32_t player_id,
+                                    uint64_t media_time_us)
+{
+	if(event_type != RG35XX_MEDIA_EVENT_END_OF_MEDIA &&
+	   event_type != RG35XX_MEDIA_EVENT_LOOPED) return;
+	rg35xx_media_event_queue_push((uint8_t)event_type, player_id, media_time_us);
+}
+
+static void rg35xx_send_media_event(const struct rg35xx_media_event_record *e)
+{
+	unsigned char p[18];
+	uint64_t t = e->media_time_us;
+	p[0] = 14;
+	p[1] = 0; p[2] = 0; p[3] = 0; p[4] = 13;
+	p[5] = e->event_type;
+	p[6] = (e->player_id >> 24) & 0xFF;
+	p[7] = (e->player_id >> 16) & 0xFF;
+	p[8] = (e->player_id >> 8) & 0xFF;
+	p[9] = e->player_id & 0xFF;
+	p[10] = (t >> 56) & 0xFF;
+	p[11] = (t >> 48) & 0xFF;
+	p[12] = (t >> 40) & 0xFF;
+	p[13] = (t >> 32) & 0xFF;
+	p[14] = (t >> 24) & 0xFF;
+	p[15] = (t >> 16) & 0xFF;
+	p[16] = (t >> 8) & 0xFF;
+	p[17] = t & 0xFF;
+	write_to_pipe(pWrite[1], p, sizeof(p));
+}
+
+static void rg35xx_drain_media_events_to_java(void)
+{
+	struct rg35xx_media_event_record e;
+	while(rg35xx_media_event_queue_pop(&e))
+		rg35xx_send_media_event(&e);
+}
 
 void retro_run(void)
@@ -969,4 +1011,6 @@
 	if(isRunning())
 	{
+		/* Serialize native completion events through the existing control writer. */
+		rg35xx_drain_media_events_to_java();
 
 		/* request frame */
@@ -1457,2 +1501,22 @@
-		kill(javaProcess, SIGKILL);
-		wait(NULL);
+		/* Closing only parent->Java stdin delivers EOF. Keep Java stdout/video
+		 * readable while RG35XXLifecycle.platformShutdown() runs in JamVM. */
+		if(pWrite[1] >= 0)
+		{
+			close(pWrite[1]);
+			pWrite[1] = -1;
+		}
+
+		int exited = 0;
+		for(int i = 0; i < 200; i++)
+		{
+			int status = 0;
+			pid_t r = waitpid(javaProcess, &status, WNOHANG);
+			if(r == javaProcess) { exited = 1; break; }
+			if(r < 0 && errno == ECHILD) { exited = 1; break; }
+			usleep(10000); /* shutdown-only grace; not a runtime watchdog */
+		}
+		if(!exited)
+		{
+			kill(javaProcess, SIGKILL);
+			waitpid(javaProcess, NULL, 0);
+		}
--- a/src/org/recompile/freej2me/Libretro.java
+++ b/src/org/recompile/freej2me/Libretro.java
@@ -21,2 +21,3 @@
 import java.io.File;
+import java.io.IOException;
 import java.net.URLDecoder;
