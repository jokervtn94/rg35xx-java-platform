 	write_to_pipe(pWrite[1], event, 5);
 }
 
+#ifdef __linux__
+static void rg35xx_release_soundfont_bytes(void)
+{
+	if(rg35xx_soundfont_bytes) free(rg35xx_soundfont_bytes);
+	rg35xx_soundfont_bytes = NULL;
+	rg35xx_soundfont_size = 0;
+}
+
+static int rg35xx_load_soundfont_bytes(void)
+{
+	FILE *f;
+	long size;
+	size_t got;
+
+	rg35xx_release_soundfont_bytes();
+	if(RG35XX_SOUNDFONT_PATH[0] == '\0')
+	{
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont path is not configured; MIDI disabled.\n");
+		return 0;
+	}
+
+	f = fopen(RG35XX_SOUNDFONT_PATH, "rb");
+	if(!f)
+	{
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont unavailable at configured path; MIDI disabled.\n");
+		return 0;
+	}
+	if(fseek(f, 0, SEEK_END) != 0 || (size = ftell(f)) <= 0 ||
+	   fseek(f, 0, SEEK_SET) != 0)
+	{
+		fclose(f);
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont could not be sized; MIDI disabled.\n");
+		return 0;
+	}
+
+	rg35xx_soundfont_bytes = (uint8_t *)malloc((size_t)size);
+	if(!rg35xx_soundfont_bytes)
+	{
+		fclose(f);
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont allocation failed; MIDI disabled.\n");
+		return 0;
+	}
+	got = fread(rg35xx_soundfont_bytes, 1, (size_t)size, f);
+	fclose(f);
+	if(got != (size_t)size)
+	{
+		rg35xx_release_soundfont_bytes();
+		log_fn(RETRO_LOG_WARN, "RG35XX SoundFont read was incomplete; MIDI disabled.\n");
+		return 0;
+	}
+	rg35xx_soundfont_size = got;
+	return 1;
+}
+
+static void *rg35xx_audio_drain_main(void *unused)
+{
+	(void)unused;
+	while(rg35xx_audio_drain_running)
+	{
+		int n = rg35xx_audio_pipe_drain(&rg35xx_java_audio_pipe);
+		if(n < 0) break;
+		usleep(2000);
+	}
+	rg35xx_audio_drain_running = 0;
+	return NULL;
+}
+
+static void rg35xx_audio_drain_start(void)
+{
+	if(rg35xx_audio_drain_started || rg35xx_java_audio_pipe.read_fd < 0) return;
+	rg35xx_audio_drain_running = 1;
+	if(pthread_create(&rg35xx_audio_drain_thread, NULL,
+	                  rg35xx_audio_drain_main, NULL) == 0)
+		rg35xx_audio_drain_started = 1;
+	else
+		rg35xx_audio_drain_running = 0;
+}
+
+static void rg35xx_audio_drain_stop(void)
+{
+	if(!rg35xx_audio_drain_started) return;
+	rg35xx_audio_drain_running = 0;
+	pthread_join(rg35xx_audio_drain_thread, NULL);
+	rg35xx_audio_drain_started = 0;
+}
+
+static void rg35xx_native_media_shutdown(void)
+{
+	rg35xx_audio_drain_stop();
+	rg35xx_audio_pipe_close(&rg35xx_java_audio_pipe);
+	rg35xx_mixer_reset();
+	rg35xx_media_event_queue_reset();
+	rg35xx_media_cache_reset();
+	rg35xx_media_runtime_shutdown();
+	rg35xx_release_soundfont_bytes();
+}
+#endif
+
 void retro_init(void)
 {
