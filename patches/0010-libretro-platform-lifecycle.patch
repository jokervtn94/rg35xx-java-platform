From: RG35XX Java Platform
Task: RGJ-B6-002..006 / RGJ-RC1-011R
Subject: [PATCH] Libretro: bind RG35XX lifecycle to Java platform and game load

This executable diff owns the Java-side lifecycle boundaries that are already
present in pinned Libretro.java. Native process teardown and EOF/platformShutdown
remain owned by 0017 so the same parser tail is not patched twice.

--- a/src/org/recompile/freej2me/Libretro.java
+++ b/src/org/recompile/freej2me/Libretro.java
@@ -21,1 +21,2 @@
 import org.recompile.mobile.MobilePlatform;
+import org.recompile.mobile.RG35XXLifecycle;
@@ -86,1 +87,4 @@
 		});
+
+		/* Process-lifetime target services attach after MobilePlatform exists. */
+		RG35XXLifecycle.platformStart();
@@ -162,5 +166,9 @@
 
 								path = new String(buffer, 0, bytesRead);
 
+								/* Flush/reset the previous game before MobilePlatform.load()
+								 * replaces loader/suite context. */
+								RG35XXLifecycle.beforeGameLoad();
 								if(Mobile.getPlatform().load(getFormattedLocation(URLDecoder.decode(path, Mobile.textEncoding))))
 								{
+									RG35XXLifecycle.afterGameLoad();
@@ -181,3 +189,4 @@
 								else
 								{
+									RG35XXLifecycle.gameLoadFailed();
 									Mobile.log(Mobile.LOG_ERROR, Libretro.class.getPackage().getName() + "." + Libretro.class.getSimpleName() + ": " + "Couldn't load jar...");
