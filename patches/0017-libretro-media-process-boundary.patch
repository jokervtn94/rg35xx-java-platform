+								}
+								int eventType = rg35xxMediaEvent[0] & 0xFF;
+								if(eventType != org.recompile.mobile.RG35XXMediaRegistry.EVENT_END_OF_MEDIA &&
+								   eventType != org.recompile.mobile.RG35XXMediaRegistry.EVENT_LOOPED) { break; }
+								int playerId = ((rg35xxMediaEvent[1] & 0xFF) << 24) |
+									((rg35xxMediaEvent[2] & 0xFF) << 16) |
+									((rg35xxMediaEvent[3] & 0xFF) << 8) |
+									(rg35xxMediaEvent[4] & 0xFF);
+								long mediaTimeUs = 0L;
+								for(int i = 5; i < 13; i++)
+									mediaTimeUs = (mediaTimeUs << 8) | (long)(rg35xxMediaEvent[i] & 0xFF);
+								if(playerId > 0 && mediaTimeUs >= 0L)
+									org.recompile.mobile.RG35XXMediaRegistry.enqueueNativeEvent(
+										playerId, eventType, mediaTimeUs);
+							break;
