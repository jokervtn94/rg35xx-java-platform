+	/* Adapter keeps the existing PlatformPlayer facade/state/listener owner while
+	 * delegating target playback to the dedicated native transport. */
+	private class rg35xxAudioPlayer extends audioplayer
+	{
+		public void realize()
+		{
+			rg35xxPlayer.realize();
+			state = Player.REALIZED;
+		}
+
+		public void prefetch()
+		{
+			if(rg35xxPlayer.prefetch()) state = Player.PREFETCHED;
+			else state = Player.REALIZED;
+		}
+
+		public void start()
+		{
+			if(rg35xxPlayer.start())
+			{
+				state = Player.STARTED;
+				notifyListeners(PlayerListener.STARTED, Long.valueOf(getMediaTime()));
+			}
+		}
+
+		public void stop()
+		{
+			if(rg35xxPlayer.stop())
+			{
+				state = Player.PREFETCHED;
+				notifyListeners(PlayerListener.STOPPED, Long.valueOf(getMediaTime()));
+			}
+		}
+
+		public void setLoopCount(int count) { rg35xxPlayer.setLoopCount(count); }
+		public long setMediaTime(long now) { return rg35xxPlayer.setMediaTime(now); }
+		public long getMediaTime() { RG35XXMediaRegistry.Entry e = RG35XXMediaRegistry.get(rg35xxPlayer.getPlayerId()); return e == null ? 0L : e.mediaTimeUs; }
+		public boolean isRunning() { return rg35xxPlayer.getState() == RG35XXNativePlayer.STARTED; }
+		public void deallocate() { if(isRunning()) stop(); state = Player.REALIZED; }
+		public void close() { rg35xxPlayer.close(); }
+		public int setNativeVolume(int level) { return rg35xxPlayer.setVolume(level); }
+	}
+
