+	private void initRG35XXDirectPlayer(InputStream stream, String type)
+	{
+		String canonical = type == null ? "" : type.toLowerCase();
+		try
+		{
+			if(canonical.contains("mid"))
+			{
+				contentType = canonical.length() == 0 ? "audio/midi" : type;
+				rg35xxPlayer = new RG35XXNativePlayer(stream, "audio/midi");
+				bindRG35XXEvents();
+				player = new rg35xxAudioPlayer();
+				return;
+			}
+			if(canonical.contains("wav"))
+			{
+				RG35XXWavDecoder.Decoded decoded = RG35XXWavDecoder.decode(stream);
+				contentType = canonical.length() == 0 ? "audio/wav" : type;
+				rg35xxPlayer = new RG35XXNativePlayer(new ByteArrayInputStream(new byte[0]), "audio/wav");
+				rg35xxPlayer.setPcm16(decoded.pcm16, decoded.sampleRate, decoded.channels);
+				bindRG35XXEvents();
+				player = new rg35xxAudioPlayer();
+				return;
+			}
+		}
+		catch(Exception e)
+		{
+			if(rg35xxPlayer != null) { rg35xxPlayer.close(); rg35xxPlayer = null; }
+			Mobile.log(Mobile.LOG_ERROR, PlatformPlayer.class.getPackage().getName() + "." + PlatformPlayer.class.getSimpleName() + ": RG35XX media setup failed: " + e.getMessage());
+		}
+
+		/* Capability reporting does not advertise other direct formats yet. */
+		contentType = type == null ? "unknown" : type;
+		player = new audioplayer();
+		disableControls = true;
+	}
+
+	private void bindRG35XXEvents()
+	{
+		rg35xxPlayer.setEventListener(new RG35XXMediaRegistry.EventListener()
+		{
+			public void onNativeMediaEvent(int playerId, int eventType, long mediaTimeUs)
+			{
+				if(eventType == RG35XXMediaRegistry.EVENT_LOOPED)
+				{
+					state = Player.STARTED;
+					notifyListeners(PlayerListener.LOOPED, Long.valueOf(mediaTimeUs));
+				}
+				else if(eventType == RG35XXMediaRegistry.EVENT_END_OF_MEDIA)
+				{
+					state = Player.PREFETCHED;
+					notifyListeners(PlayerListener.END_OF_MEDIA, Long.valueOf(mediaTimeUs));
+				}
+			}
+		});
+	}
+
