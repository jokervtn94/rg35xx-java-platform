From: RG35XX Java Platform
Task: RGJ-RC1-011CC / RGJ-RC1-011CD
Subject: [PATCH] graphics: composite text safely and restore RG35XX RGB565 video

RC1-011CC keeps the Java2D glyph bypass while rendering text into an isolated
ARGB bitmap and compositing through PlatformGraphics.drawRGB.

RC1-011CD follows device screenshots showing deterministic alternating blue
columns even after text compositing. The consolidated core currently submits an
unsigned-int XRGB8888 frame with a four-byte pitch, while the historical RG35XX
Golden Baseline is recorded as RGB565-fastpack. Preserve the existing 32-bit
working frame for rotation/pointer logic, but convert it into a dedicated RGB565
submission buffer at the libretro boundary and advertise the matching pixel
format.

--- a/src/org/recompile/mobile/PlatformGraphics.java
+++ b/src/org/recompile/mobile/PlatformGraphics.java
@@ -853,7 +853,20 @@
 			if((anchor & Graphics.BOTTOM)>0) { y = y-height; }
 			if((anchor & Graphics.BASELINE)>0) { y = y-ascent; }
 
-			gc.drawString(str, x, y);
+			if(RG35XXPlatformProfile.isActive() && !Mobile.isDoJa)
+			{
+				final int bitmapWidth = RG35XXBitmapText.width(str);
+				if(bitmapWidth > 0)
+				{
+					final int[] raster = RG35XXBitmapText.render(str, getColor());
+					drawRGB(raster, 0, bitmapWidth, x, y - ascent,
+						bitmapWidth, RG35XXBitmapText.CELL_HEIGHT, true);
+				}
+			}
+			else
+			{
+				gc.drawString(str, x, y);
+			}
 		}
 	}
 
--- a/src/libretro/freej2me_libretro.c
+++ b/src/libretro/freej2me_libretro.c
@@ -165,7 +165,8 @@
 unsigned int frameHeight = MAX_HEIGHT;
 unsigned int frameSize = MAX_WIDTH * MAX_HEIGHT;
 unsigned int frameBufferSize = MAX_WIDTH * MAX_HEIGHT * 3;
 unsigned int frame[MAX_WIDTH * MAX_HEIGHT];
+uint16_t rg35xxFrame565[MAX_WIDTH * MAX_HEIGHT];
 unsigned char frameBuffer[MAX_WIDTH * MAX_HEIGHT * 3];
 unsigned char frameHeader[15]; // This is always frameHeader's length in Libretro.java -1 (we read the status byte separately)
 struct retro_game_info gameinfo;
@@ -174,6 +175,20 @@
 bool fast_forwarding = false;
 int framesDropped = 0;
 
+static void rg35xx_video_submit(void)
+{
+	unsigned int i;
+	for(i = 0; i < frameSize; i++)
+	{
+		const unsigned int p = frame[i];
+		const uint16_t r = (uint16_t)((p >> 19) & 0x1F);
+		const uint16_t g = (uint16_t)((p >> 10) & 0x3F);
+		const uint16_t b = (uint16_t)((p >> 3) & 0x1F);
+		rg35xxFrame565[i] = (uint16_t)((r << 11) | (g << 5) | b);
+	}
+	Video(rg35xxFrame565, frameWidth, frameHeight, sizeof(uint16_t) * frameWidth);
+}
+
 float normal_throttle_rate = DEFAULT_FPS;
 
